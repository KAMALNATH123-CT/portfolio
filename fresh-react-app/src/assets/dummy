import React, { useState } from 'react';
import Header from './Header';
import ScoreSection from './ScoreSection';
import GameSection from './GameSection';
import Footer from './Footer';
import styles from './FaceMatchGame.module.css';

const FACE_POOL = ['😀', '😎', '😡', '🤢', '🤡', '🤠', '👽', '🤖', '👻', '🥳', '🤓', '🦊', '🐯', '🦁', '🦉'];

export default function FaceMatchGame() {
  const [score, setScore] = useState(0);
  const [chances, setChances] = useState(3);
  const [gridFaces, setGridFaces] = useState(Array(9).fill('❓'));
  const [targetFace, setTargetFace] = useState('?');
  const [message, setMessage] = useState('Click "Start Game" to begin!');
  const [messageColor, setMessageColor] = useState('#333');
  const [isGameActive, setIsGameActive] = useState(false);
  const [wrongSelections, setWrongSelections] = useState([]);
  const [correctSelection, setCorrectSelection] = useState(null);
  const [btnText, setBtnText] = useState('Start Game');

  const startRound = () => {
    setIsGameActive(true);
    setChances(3);
    setWrongSelections([]);
    setCorrectSelection(null);
    setMessage('Find the matching face!');
    setMessageColor('#333');

    const shuffled = [...FACE_POOL].sort(() => 0.5 - Math.random());
    const selectedFaces = shuffled.slice(0, 9);
    setGridFaces(selectedFaces);

    const randomTarget = selectedFaces[Math.floor(Math.random() * 9)];
    setTargetFace(randomTarget);
  };

  const handleCardClick = (face, index) => {
    if (!isGameActive || wrongSelections.includes(index) || correctSelection === index) return;

    if (face === targetFace) {
      setCorrectSelection(index);
      setScore(prev => prev + 1);
      setMessage('🎉 Correct! Well done!');
      setMessageColor('#2ecc71');
      setIsGameActive(false);
      setBtnText('Play Next Round');
    } else {
      const nextChances = chances - 1;
      setChances(nextChances);
      setWrongSelections(prev => [...prev, index]);

      if (nextChances <= 0) {
        setMessage('💥 Game Over! You ran out of chances.');
        setMessageColor('#e74c3c');
        setIsGameActive(false);
        setBtnText('Restart Game');
      } else {
        setMessage(`Wrong! You have ${nextChances} chances left.`);
        setMessageColor('#e74c3c');
      }
    }
  };

  const handleActionBtn = () => {
    if (btnText === 'Restart Game') {
      setScore(0);
    }
    startRound();
  };

  return (
    <div className={styles.appContainer}>
      <Header />
      <main className={styles.mainContent}>
        <ScoreSection score={score} chances={chances} />
        <GameSection
          gridFaces={gridFaces}
          targetFace={targetFace}
          message={message}
          messageColor={messageColor}
          isGameActive={isGameActive}
          wrongSelections={wrongSelections}
          correctSelection={correctSelection}
          btnText={btnText}
          onCardClick={handleCardClick}
          onActionBtnClick={handleActionBtn}
        />
      </main>
      <Footer />
    </div>
  );
}






